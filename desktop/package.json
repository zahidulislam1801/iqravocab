{
  "name": "iqra-vocab",
  "version": "1.0.0",
  "description": "IQRA Vocab",
  "author": "Zahid",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.iqravocab.app",
    "productName": "IQRA Vocab",
    "icon": "icon.png",
    "files": [
      "main.js",
      "icon.png",
      "index.html",
      "manifest.webmanifest",
      "logo.svg",
      "privacy.html",
      "terms.html"
    ],
    "win": {
      "target": "portable",
      "artifactName": "IQRA Vocab.exe"
    }
  }
}
